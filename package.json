{
  "name": "maple-line-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --test tests/*.test.js",
    "lint": "oxlint --deny-warnings src tests",
    "format": "prettier --write src api tests *.json",
    "format:check": "prettier --check src api tests *.json",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "@maple-line/world-spec": "file:packages/world-spec",
    "ai": "7.0.107",
    "@maple-line/voice-score": "file:packages/voice-score"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "oxlint": "1.83.0",
    "prettier": "3.9.8",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": "24.x"
  }
}
